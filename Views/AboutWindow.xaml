<Window x:Class="EditWave.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе" 
        Height="500" 
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="EditWave" 
                   FontSize="28" 
                   FontWeight="Bold" 
                   Foreground="#FF4081"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,5"/>

        <TextBlock Grid.Row="1" 
                   Text="Версия 2.0" 
                   FontSize="16" 
                   Foreground="#555"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <Separator Grid.Row="2" Background="#CCC" Margin="0,5,0,10"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3">
            <TextBlock Text="Автор: " FontSize="13" FontWeight="Bold" Foreground="#333"/>
            <TextBlock Text="Семьянова Маргарита Евгеньевна" FontSize="13" Foreground="#555"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3">
            <TextBlock Text="Группа: " FontSize="13" FontWeight="Bold" Foreground="#333"/>
            <TextBlock Text="2307б1" FontSize="13" Foreground="#555"/>
        </StackPanel>

        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Margin="0,10,0,5">
            <StackPanel>
                <TextBlock Text="Возможности:" FontSize="13" FontWeight="Bold" Foreground="#333" Margin="0,0,0,5"/>
                <TextBlock Text=" - Воспроизведение, пауза, остановка" Foreground="#555" FontSize="12"/>
                <TextBlock Text=" - Открытие WAV и MP3 файлов" Foreground="#555" FontSize="12"/>
                <TextBlock Text=" - Экспорт в WAV и MP3 (выбор битрейта)" Foreground="#555" FontSize="12"/>
                <TextBlock Text=" - Обрезка и удаление выделенных фрагментов" Foreground="#555" FontSize="12"/>
                <TextBlock Text=" - Копирование и вставка фрагментов (Ctrl+C/V)" Foreground="#555" FontSize="12"/>
                <TextBlock Text=" - Вставка тишины" Foreground="#555" FontSize="12"/>
                <TextBlock Text=" - Усиление, реверс, нормализация" Foreground="#555" FontSize="12"/>
                <TextBlock Text=" - Плавное начало и затухание" Foreground="#555" FontSize="12"/>
                <TextBlock Text=" - Изменение скорости (0.25x - 4x)" Foreground="#555" FontSize="12"/>
                <TextBlock Text=" - Изменение тона без изменения скорости" Foreground="#555" FontSize="12"/>
                <TextBlock Text=" - Эквалайзер (басы и высокие)" Foreground="#555" FontSize="12"/>
                <TextBlock Text=" - Конвертер моно / стерео" Foreground="#555" FontSize="12"/>
                <TextBlock Text=" - Обрезка тишины в начале и конце" Foreground="#555" FontSize="12"/>
                <TextBlock Text=" - Зацикленное воспроизведение выделения" Foreground="#555" FontSize="12"/>
                <TextBlock Text=" - Отмена и повтор (Ctrl+Z / Ctrl+Y)" Foreground="#555" FontSize="12"/>
                <TextBlock Text=" - Сохранение и загрузка проектов (LiteDB)" Foreground="#555" FontSize="12"/>
                <TextBlock Text=" - Перетаскивание файлов в окно" Foreground="#555" FontSize="12"/>
                <TextBlock Text=" - Визуализация волновой формы" Foreground="#555" FontSize="12"/>
                <TextBlock Text=" - Горячие клавиши" Foreground="#555" FontSize="12"/>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="6" 
                Content="OK" 
                Width="100" Height="35"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,5"
                Background="#FF4081" Foreground="White"
                BorderThickness="0" Cursor="Hand"
                Click="OkButton_Click" IsDefault="True">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>
