<Window x:Class="EditWave.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EditWave.Views"
        Title="EditWave" Height="550" Width="950" MinHeight="500" MinWidth="800"
           Icon="../free-icon-music-application-8030594.ico"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#E0E0E0" Foreground="#333">
            <MenuItem Header="Файл">
                <MenuItem Header="Открыть" Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="Сохранить проект" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Экспорт аудио" Command="{Binding ExportCommand}" InputGestureText="Ctrl+E"/>
                <Separator/>
                <MenuItem Header="Выход" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="Правка">
                <MenuItem Header="Обрезать" Command="{Binding TrimCommand}" InputGestureText="Ctrl+T"/>
                <MenuItem Header="Удалить" Command="{Binding DeleteCommand}" InputGestureText="Del"/>
                <Separator/>
                <MenuItem Header="Копировать" Command="{Binding CopySelectionCommand}" InputGestureText="Ctrl+C"/>
                <MenuItem Header="Вставить" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V"/>
                <Separator/>
                <MenuItem Header="Вставить тишину..." Command="{Binding InsertSilenceCommand}"/>
            </MenuItem>
            <MenuItem Header="Эффекты">
                <MenuItem Header="Усиление" Command="{Binding ApplyGainCommand}" InputGestureText="Ctrl+G"/>
                <MenuItem Header="Реверс" Command="{Binding ApplyReverseCommand}" InputGestureText="Ctrl+R"/>
                <MenuItem Header="Плавное начало" Command="{Binding ApplyFadeInCommand}"/>
                <MenuItem Header="Плавное затухание" Command="{Binding ApplyFadeOutCommand}"/>
                <MenuItem Header="Нормализовать" Command="{Binding ApplyNormalizeCommand}"/>
                <MenuItem Header="Обрезать тишину" Command="{Binding TrimSilenceCommand}"/>
                <Separator/>
                <MenuItem Header="Скорость..." Command="{Binding ApplySpeedCommand}"/>
                <MenuItem Header="Тон..." Command="{Binding ApplyPitchCommand}"/>
                <MenuItem Header="Эквалайзер..." Command="{Binding ApplyEQCommand}"/>
            </MenuItem>
            <MenuItem Header="Конвертировать">
                <MenuItem Header="В моно" Command="{Binding ToMonoCommand}"/>
                <MenuItem Header="В стерео" Command="{Binding ToStereoCommand}"/>
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="О программе" Command="{Binding ShowAboutCommand}"/>
            </MenuItem>
        </Menu>

        <ToolBar Grid.Row="1" Background="#E0E0E0">
            <Button Command="{Binding PlayCommand}" Content="▶" Margin="2" Padding="5" Background="White" Foreground="#FF4081" ToolTip="Воспроизвести"/>
            <Button Command="{Binding PauseCommand}" Content="⏸" Margin="2" Padding="5" Background="White" Foreground="#FF4081" ToolTip="Пауза"/>
            <Button Command="{Binding StopCommand}" Content="⏹" Margin="2" Padding="5" Background="White" Foreground="#FF4081" ToolTip="Остановить"/>
            <Separator/>
            <Button Command="{Binding TrimCommand}" Content="✂ Обрезать" Margin="2" Padding="5" Background="White" Foreground="#FF4081" ToolTip="Обрезать по выделению"/>
            <Button Command="{Binding DeleteCommand}" Content="🗑 Удалить" Margin="2" Padding="5" Background="White" Foreground="#FF4081" ToolTip="Удалить выделенное"/>
            <Separator/>
            <Button Command="{Binding CopySelectionCommand}" Content="📋 Копировать" Margin="2" Padding="5" Background="White" Foreground="#FF4081" ToolTip="Копировать выделение (Ctrl+C)"/>
            <Button Command="{Binding PasteCommand}" Content="📄 Вставить" Margin="2" Padding="5" Background="White" Foreground="#FF4081" ToolTip="Вставить из буфера (Ctrl+V)"/>
            <Button Command="{Binding InsertSilenceCommand}" Content="⬛ Тишина" Margin="2" Padding="5" Background="White" Foreground="#FF4081" ToolTip="Вставить тишину"/>
            <Button Command="{Binding TrimSilenceCommand}" Content="🔇 Тишина" Margin="2" Padding="5" Background="White" Foreground="#FF4081" ToolTip="Обрезать тишину"/>
            <Separator/>
            <Button Command="{Binding ToMonoCommand}" Content="1️⃣ Моно" Margin="2" Padding="5" Background="White" Foreground="#FF4081" ToolTip="Конвертировать в моно"/>
            <Button Command="{Binding ToStereoCommand}" Content="2️⃣ Стерео" Margin="2" Padding="5" Background="White" Foreground="#FF4081" ToolTip="Конвертировать в стерео"/>
            <Separator/>
            <Button Command="{Binding SaveProjectCommand}" Content="💾 Сохранить проект" Margin="2" Padding="5" Background="White" Foreground="#FF4081" ToolTip="Сохранить проект в базу данных"/>
            <Button Command="{Binding ExportCommand}" Content="📁 Экспорт" Margin="2" Padding="5" Background="White" Foreground="#FF4081" ToolTip="Экспортировать аудио в файл"/>
            <Separator/>
            <Button Command="{Binding UndoCommand}" Content="↩️ Отменить" IsEnabled="{Binding CanUndo}" Margin="2" Padding="5" Background="White" Foreground="#FF4081" ToolTip="Ctrl+Z"/>
            <Button Command="{Binding RedoCommand}" Content="↪️ Повторить" IsEnabled="{Binding CanRedo}" Margin="2" Padding="5" Background="White" Foreground="#FF4081" ToolTip="Ctrl+Y"/>
        </ToolBar>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="10" Background="White" CornerRadius="5" BorderBrush="#CCC" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>
                    <views:WaveformControl x:Name="WaveformControl"
                                           Samples="{Binding WaveformSamples}"
                                           Duration="{Binding Duration}"
                                           PlaybackPosition="{Binding CurrentPositionNormalized}"
                                           SelectionChanged="OnWaveformSelectionChanged"
                                           Margin="5"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="10" Background="#E0E0E0" CornerRadius="5" BorderBrush="#CCC" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Эффекты" FontWeight="Bold" Foreground="#333" Margin="0,0,0,10"/>
                        <CheckBox Content="Зациклить выделение" IsChecked="{Binding IsLoopEnabled}" Foreground="#333" Margin="0,0,0,10" ToolTip="Воспроизведение выделенного фрагмента в цикле"/>
                        <TextBlock Text="Усиление:" Foreground="#333"/>
                        <Slider Minimum="0" Maximum="200" Value="{Binding Gain}" Margin="0,5" ToolTip="0% = тихо, 100% = оригинал, 200% = громче"/>
                        <TextBlock Text="{Binding Gain, StringFormat={}{0:F0}%}" HorizontalAlignment="Right" Foreground="#333"/>
                        <Button Command="{Binding ApplyGainCommand}" Content="Применить усиление" Margin="5" Padding="5" Background="#FF4081" Foreground="White" BorderThickness="0"/>
                        <Button Command="{Binding ApplyReverseCommand}" Content="Применить реверс" Margin="5" Padding="5" Background="#FF4081" Foreground="White" BorderThickness="0"/>
                        <Button Command="{Binding ApplyFadeInCommand}" Content="Плавное начало" Margin="5" Padding="5" Background="#FF4081" Foreground="White" BorderThickness="0"/>
                        <Button Command="{Binding ApplyFadeOutCommand}" Content="Плавное затухание" Margin="5" Padding="5" Background="#FF4081" Foreground="White" BorderThickness="0"/>
                        <Button Command="{Binding ApplyNormalizeCommand}" Content="Нормализовать" Margin="5" Padding="5" Background="#FF4081" Foreground="White" BorderThickness="0"/>

                        <Separator Margin="0,10,0,10"/>

                        <TextBlock Text="Скорость:" Foreground="#333"/>
                        <Slider Minimum="0.25" Maximum="4" Value="{Binding Speed}" TickFrequency="0.25" IsSnapToTickEnabled="True" Margin="0,5" ToolTip="0.25x - 4x"/>
                        <TextBlock Text="{Binding Speed, StringFormat={}{0:F2}x}" HorizontalAlignment="Right" Foreground="#333"/>
                        <Button Command="{Binding ApplySpeedCommand}" Content="Применить скорость" Margin="5" Padding="5" Background="#FF4081" Foreground="White" BorderThickness="0"/>

                        <Separator Margin="0,10,0,10"/>

                        <TextBlock Text="Тон:" Foreground="#333"/>
                        <Slider Minimum="0.5" Maximum="2" Value="{Binding Pitch}" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,5" ToolTip="0.5x - 2x"/>
                        <TextBlock Text="{Binding Pitch, StringFormat={}{0:F2}x}" HorizontalAlignment="Right" Foreground="#333"/>
                        <Button Command="{Binding ApplyPitchCommand}" Content="Применить тон" Margin="5" Padding="5" Background="#FF4081" Foreground="White" BorderThickness="0"/>

                        <Separator Margin="0,10,0,10"/>

                        <TextBlock Text="Эквалайзер" FontWeight="Bold" Foreground="#333" Margin="0,0,0,5"/>
                        <TextBlock Text="Басы:" Foreground="#333"/>
                        <Slider Minimum="-10" Maximum="10" Value="{Binding BassGain}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,5" ToolTip="-10 ослабить, +10 усилить"/>
                        <TextBlock Text="{Binding BassGain, StringFormat={}{0:F0}}" HorizontalAlignment="Right" Foreground="#333"/>
                        <TextBlock Text="Высокие:" Foreground="#333"/>
                        <Slider Minimum="-10" Maximum="10" Value="{Binding TrebleGain}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,5" ToolTip="-10 ослабить, +10 усилить"/>
                        <TextBlock Text="{Binding TrebleGain, StringFormat={}{0:F0}}" HorizontalAlignment="Right" Foreground="#333"/>
                        <Button Command="{Binding ApplyEQCommand}" Content="Применить эквалайзер" Margin="5" Padding="5" Background="#FF4081" Foreground="White" BorderThickness="0"/>

                        <Separator Margin="0,10,0,10"/>

                        <TextBlock Text="Конвертировать" FontWeight="Bold" Foreground="#333" Margin="0,0,0,5"/>
                        <Button Command="{Binding ToMonoCommand}" Content="В моно" Margin="5" Padding="5" Background="#FF4081" Foreground="White" BorderThickness="0"/>
                        <Button Command="{Binding ToStereoCommand}" Content="В стерео" Margin="5" Padding="5" Background="#FF4081" Foreground="White" BorderThickness="0"/>

                        <Separator Margin="0,15,0,10"/>

                        <TextBlock Text="Проекты" FontWeight="Bold" Foreground="#333" Margin="0,0,0,5"/>
                        <TextBlock Text="Двойной клик - загрузить" FontSize="10" Foreground="#666" Margin="0,0,0,5"/>
                        <ListBox Height="250" ItemsSource="{Binding ProjectsList}" SelectedItem="{Binding SelectedProject}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="#333" Grid.Column="0"/>
                                        <Button Grid.Column="1" Content="✏️" Background="Transparent" Foreground="#333" BorderThickness="0"
                                                Command="{Binding DataContext.RenameProjectCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" Margin="0,0,5,0" ToolTip="Переименовать"/>
                                        <Button Grid.Column="2" Content="X" Background="Transparent" Foreground="Red" BorderThickness="0"
                                                Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding Id}" ToolTip="Удалить проект"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#E0E0E0" Padding="10" Margin="5,0,5,5" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding CurrentTime}" VerticalAlignment="Center" Foreground="#333" Margin="0,0,10,0" FontFamily="Consolas" FontSize="13"/>
                <TextBlock Grid.Column="0" Text="{Binding SelectionDuration}" VerticalAlignment="Center" Foreground="#FF4081" Margin="120,0,0,0" FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
                <Slider Grid.Column="1" Value="{Binding CurrentPosition}" Maximum="{Binding Duration}" Margin="10,0" ToolTip="Перемотка"/>

                <ProgressBar Grid.Column="2" Width="100" Height="15" Margin="10,0" IsIndeterminate="True">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FormatInfo}" VerticalAlignment="Center" Foreground="#666" FontFamily="Consolas" FontSize="11" Margin="10,0"/>
                    <TextBlock Text="🔊" Margin="0,0,5,0" Foreground="#333"/>
                    <Slider Width="100" Minimum="0" Maximum="1" Value="{Binding Volume}" ToolTip="Громкость воспроизведения"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>